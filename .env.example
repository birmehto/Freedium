# ──────────────────────────────────────────────────────────────
# AdMob identifiers — copy this file to `.env` and fill in your own.
#
# `.env` and the generated `lib/core/config/env.g.dart` are both git-ignored,
# so real ids never reach version control. Two consumers read this file:
#   • the Dart app, via `envied` (obfuscated into `env.g.dart`), and
#   • the Android build, via the `admobAppId` manifest placeholder.
#
# At least `flutter pub get` + `dart run build_runner build` are required after
# editing this file. Without a `.env`, the app falls back to Google's public
# test ids below, so a fresh clone still builds and serves test ads.
# ──────────────────────────────────────────────────────────────

# Rewarded-video ad unit shown by the "Support Freedium" flow.
REWARDED_AD_UNIT_ID=ca-app-pub-3940256099942544/5224354917

# Google Mobile Ads application id (Android manifest meta-data).
ADMOB_APP_ID=ca-app-pub-3940256099942544~3347511713
