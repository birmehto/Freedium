<?xml version="1.0" encoding="utf-8"?>
<!--
  Freedium keeps everything on-device only.

  android:allowBackup="false" already blocks cloud backup and device transfer,
  and this file states the same intent explicitly for Android 12+ so the app
  never advertises readable backup data to the platform.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
